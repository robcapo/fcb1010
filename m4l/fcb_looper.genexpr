// FCB Looper: three Boomerang style loops with their own clock.
//
// in1, in2: audio in (left, right)
// in3: a phasor~ that goes from 0 to 1 once per bar of the song. Only
//      used when sync_on is 1.
// out1, out2: the loops (left, right). The dry input isn't passed through.
// out3, out4, out5: status of loops 1-3
//
// Loops are controlled by setting tgt1, tgt2 and tgt3 to:
//   0 stop, 1 record, 2 play, 3 overdub, 4 erase, 5 nothing
// A loop reacts when its target changes, so setting 5 then the target
// again repeats a command.
//
// Status is: 0 empty, 1 stopped, 2 recording, 3 playing, 4 overdubbing,
//            5 waiting to start recording
//
// With sync_on 0, the first loop recorded sets the master length. The
// other loops start recording, and start playing, when the master comes
// around to its start, and stop recording on a multiple of its length.
// Erasing every loop clears the master length.
//
// With sync_on 1, loops start, stop and finish recording on the next bar.
// If autostop_bars is above 0, recording finishes after that many bars.

Param tgt1(0);
Param tgt2(0);
Param tgt3(0);
Param sync_on(0);
Param autostop_bars(0);
Param feedback(1);

Buffer b1("fcbloop1");
Buffer b2("fcbloop2");
Buffer b3("fcbloop3");

// One row per loop:
// 0 state, 1 pending, 2 position, 3 length, 4 bars recorded,
// 5 last target, 6 overdub when it starts playing, 7 recording the master
Data loops(3, 8);

History prevbar(0);
History master(0);
History clk(0);
// 1 if the master length was set in the last sample
History newmaster(0);

// pending: 0 none, 1 start recording, 2 finish recording, 3 start playing, 4 stop

maxlen = dim(b1) - 1;
barwrap = in3 < prevbar - 0.5;
prevbar = in3;

// Loops before the master loop missed its start in the last sample, so
// give them a boundary now. One sample late isn't audible.
clkwrap = newmaster;
newmaster = 0;
if (master > 0) {
	clk = clk + 1;
	if (clk >= master) {
		clk = 0;
		clkwrap = 1;
	}
}

masterrec = 0;
for (i = 0; i < 3; i += 1) {
	if (peek(loops, i, 7) == 1 && peek(loops, i, 0) == 2) {
		masterrec = 1;
	}
}

outl = 0;
outr = 0;
status1 = 0;
status2 = 0;
status3 = 0;

for (i = 0; i < 3; i += 1) {
	st = peek(loops, i, 0);
	pend = peek(loops, i, 1);
	pos = peek(loops, i, 2);
	len = peek(loops, i, 3);
	bars = peek(loops, i, 4);
	last = peek(loops, i, 5);
	odafter = peek(loops, i, 6);
	ismaster = peek(loops, i, 7);

	t = tgt3;
	if (i == 0) {
		t = tgt1;
	} else if (i == 1) {
		t = tgt2;
	}
	free = sync_on == 0 && master == 0;
	finish = 0;

	// Commands
	if (t != last) {
		last = t;
		if (t == 4) {
			st = 0;
			pend = 0;
			pos = 0;
			len = 0;
			odafter = 0;
			ismaster = 0;
		} else if (t == 1) {
			if (st == 0) {
				if (free && masterrec == 0) {
					st = 2;
					pend = 0;
					pos = 0;
					bars = 0;
					odafter = 0;
					ismaster = 1;
					masterrec = 1;
				} else {
					pend = 1;
				}
			}
		} else if (t == 2 || t == 3) {
			if (st == 2) {
				odafter = t == 3;
				if (ismaster == 1 && sync_on == 0) {
					finish = 1;
				} else {
					pend = 2;
				}
			} else if (st == 0) {
				// Cancel waiting to record
				pend = 0;
			} else if (st == 1) {
				odafter = t == 3;
				if (free) {
					st = 3 + odafter;
					pos = 0;
				} else {
					pend = 3;
				}
			} else if (st == 3 && t == 3) {
				st = 4;
				pend = 0;
			} else if (st == 4 && t == 2) {
				st = 3;
				pend = 0;
			} else {
				// Cancel a pending stop
				pend = 0;
			}
		} else if (t == 0) {
			if (st == 0 || st == 1) {
				// Cancel waiting to record or play
				pend = 0;
			} else if (st == 3 || st == 4) {
				if (sync_on == 1) {
					pend = 4;
				} else {
					st = 1;
					pend = 0;
				}
			}
		}
	}

	// Timing
	boundary = clkwrap;
	if (sync_on == 1) {
		boundary = barwrap;
	}
	if (st == 2 && pos >= maxlen) {
		// Out of room
		finish = 1;
	} else if (pend == 1 && free && masterrec == 0) {
		// Waiting for a master that was erased, so become the master
		st = 2;
		pend = 0;
		pos = 0;
		bars = 0;
		odafter = 0;
		ismaster = 1;
		masterrec = 1;
	} else if (finish == 0 && boundary == 1) {
		if (st == 2 && ismaster == 0) {
			bars = bars + 1;
			if (pend == 2 || (sync_on == 1 && autostop_bars > 0 && bars >= autostop_bars)) {
				finish = 1;
			}
		} else if (pend == 1) {
			st = 2;
			pend = 0;
			pos = 0;
			bars = 0;
			odafter = 0;
		} else if (pend == 3) {
			st = 3 + odafter;
			pend = 0;
			pos = 0;
		} else if (pend == 4) {
			st = 1;
			pend = 0;
		}
	}
	if (finish == 1) {
		len = pos;
		st = 3 + odafter;
		pend = 0;
		pos = 0;
		if (ismaster == 1) {
			ismaster = 0;
			masterrec = 0;
			if (master == 0 && len > 0) {
				// Loops after this one in the same sample see the new master start
				master = len;
				clk = 0;
				clkwrap = 1;
				newmaster = i > 0;
			}
		}
		if (len == 0) {
			st = 0;
		}
	}

	// Audio
	l = 0;
	r = 0;
	if (st == 3 || st == 4) {
		if (i == 0) {
			l = peek(b1, pos, 0);
			r = peek(b1, pos, 1);
		} else if (i == 1) {
			l = peek(b2, pos, 0);
			r = peek(b2, pos, 1);
		} else {
			l = peek(b3, pos, 0);
			r = peek(b3, pos, 1);
		}
		outl = outl + l;
		outr = outr + r;
	}
	if (st == 2 || st == 4) {
		wl = in1;
		wr = in2;
		if (st == 4) {
			wl = l * feedback + in1;
			wr = r * feedback + in2;
		}
		if (i == 0) {
			poke(b1, wl, pos, 0);
			poke(b1, wr, pos, 1);
		} else if (i == 1) {
			poke(b2, wl, pos, 0);
			poke(b2, wr, pos, 1);
		} else {
			poke(b3, wl, pos, 0);
			poke(b3, wr, pos, 1);
		}
	}
	if (st >= 2) {
		pos = pos + 1;
		if (st != 2 && pos >= len) {
			pos = 0;
		}
	}

	status = st;
	if (st == 0 && pend == 1) {
		status = 5;
	}
	if (i == 0) {
		status1 = status;
	} else if (i == 1) {
		status2 = status;
	} else {
		status3 = status;
	}

	poke(loops, st, i, 0);
	poke(loops, pend, i, 1);
	poke(loops, pos, i, 2);
	poke(loops, len, i, 3);
	poke(loops, bars, i, 4);
	poke(loops, last, i, 5);
	poke(loops, odafter, i, 6);
	poke(loops, ismaster, i, 7);
}

// Erasing every loop clears the master length
if (peek(loops, 0, 0) == 0 && peek(loops, 1, 0) == 0 && peek(loops, 2, 0) == 0 && masterrec == 0) {
	master = 0;
	clk = 0;
}

out1 = outl;
out2 = outr;
out3 = status1;
out4 = status2;
out5 = status3;
