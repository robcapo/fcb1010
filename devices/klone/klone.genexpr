// Klone: a Klon Centaur style overdrive for gen~.
// Signal levels are treated as volts: 1.0 (0 dBFS) = 1 V peak.
// Keep this file in step with reference.py, which mirrors it for testing.

Param p_gain(5, min=0, max=10);
Param p_treble(5, min=0, max=10);
Param p_output(5, min=0, max=10);

// One-pole lowpass, topology-preserving transform (zero-delay feedback).
lp1(x, fc) {
	History z(0);
	g = tan(pi * fc / samplerate);
	v = (x - z) * g / (1 + g);
	y = v + z;
	z = y + v;
	return y;
}

// One-pole lowpass with a fixed cutoff; used as a parameter smoother.
smoother(x, coeff) {
	History s(0);
	s = s + (x - s) * coeff;
	return s;
}

// Germanium diode pair to ground (1N34A), modelled as x / sqrt(1 + x^2)
// with first-order antiderivative anti-aliasing. The antiderivative is
// sqrt(1 + x^2), and (F(u) - F(u1)) / (u - u1) simplifies exactly to
// (u + u1) / (F(u) + F(u1)), so there is no divide-by-zero case.
diodes(x, vf) {
	History u1(0);
	u = x / vf;
	y = (u + u1) / (sqrt(1 + u * u) + sqrt(1 + u1 * u1));
	u1 = u;
	return y * vf;
}

// Audio-taper pot law: 0 at 0, 1 at 1, about 15% at noon.
audio_taper(t) {
	return (pow(30, t) - 1) / 29;
}

channel(x, gain_t, treble_db, out_amp) {
	// Input buffer coupling caps.
	xin = x - lp1(x, 16);

	// Clipping stage: the gain is applied to content above about 400 Hz
	// and the feedback cap closes the top end in as gain goes up, which
	// is where the mid hump comes from.
	taper = audio_taper(gain_t);
	hp = xin - lp1(xin, 400);
	pre = xin + 120 * taper * hp;
	pre = lp1(pre, 12000 / (1 + 3 * taper));
	dirty = diodes(pre, 0.35);

	// Dual-gang gain pot: the second gang turns the clean path down as
	// the first turns the gain up, but never all the way off.
	clean = xin * (1 - 0.9 * gain_t);

	// Summing amp: the clipped path goes in at twice the weight of the clean
	// one, and the feedback cap rolls off the fizz.
	summed = lp1(clean + 2 * dirty, 6500);

	// Treble: active first-order high shelf around 1.2 kHz.
	lo = lp1(summed, 1200);
	toned = lo + dbtoa(treble_db) * (summed - lo);

	// Output volume, then the output coupling cap.
	y = toned * out_amp;
	return y - lp1(y, 8);
}

// 20 ms parameter smoothing.
k = 1 - exp(-1 / (0.02 * samplerate));
gain_t = smoother(p_gain / 10, k);
treble_db = smoother((p_treble - 5) * 2.4, k);
out_amp = smoother(2.2 * audio_taper(p_output / 10), k);

out1 = channel(in1, gain_t, treble_db, out_amp);
out2 = channel(in2, gain_t, treble_db, out_amp);
